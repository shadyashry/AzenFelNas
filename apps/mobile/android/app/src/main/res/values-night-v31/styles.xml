<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own splash: the logo's own green with no icon, as
         the in-app intro opens before it fades the logo in (DESIGN.md section 15 D113). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- The launch green, not the theme's white or black: it shows between the launch screen and
             Flutter's first frame, and the in-app intro opens on it (DESIGN.md section 15 D116). -->
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
