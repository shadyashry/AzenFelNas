          "sql": "CREATE TABLE IF NOT EXISTS \"package_files\" (\"type\" TEXT NOT NULL, \"version\" TEXT NOT NULL, \"path\" TEXT NOT NULL, \"sha256\" TEXT NOT NULL, \"source\" TEXT NOT NULL, \"state\" TEXT NOT NULL, \"updated_utc\" INTEGER NOT NULL, PRIMARY KEY (\"type\", \"version\"));"
        }
      ]
    },
    {
      "name": "package_trust",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"package_trust\" (\"id\" INTEGER NOT NULL, \"root_json\" BLOB NULL, \"timestamp_sequence\" INTEGER NOT NULL, \"snapshot_sequence\" INTEGER NOT NULL, \"targets_sequence\" INTEGER NOT NULL, \"timestamp_sha256\" TEXT NULL, \"snapshot_sha256\" TEXT NULL, \"targets_sha256\" TEXT NULL, \"last_sync_utc\" INTEGER NOT NULL, \"last_verified_utc\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "gazetteer",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"gazetteer\" (\"id\" INTEGER NOT NULL, \"name\" TEXT NOT NULL, \"ascii_name\" TEXT NOT NULL, \"alt_names_json\" TEXT NOT NULL, \"country\" TEXT NOT NULL, \"admin1\" TEXT NOT NULL, \"lat\" REAL NOT NULL, \"lon\" REAL NOT NULL, \"population\" INTEGER NOT NULL, \"zone_id\" TEXT NOT NULL, \"name_norm\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "gazetteer_names",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"gazetteer_names\" (\"search_key\" TEXT NOT NULL, \"place_id\" INTEGER NOT NULL REFERENCES gazetteer (id), \"name\" TEXT NOT NULL, PRIMARY KEY (\"search_key\", \"place_id\")) WITHOUT ROWID;"
