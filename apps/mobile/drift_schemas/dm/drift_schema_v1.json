    {
      "name": "active_packages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"active_packages\" (\"type\" TEXT NOT NULL, \"version\" TEXT NOT NULL, \"sequence\" INTEGER NOT NULL, \"sha256\" TEXT NOT NULL, \"source\" TEXT NOT NULL, \"activated_utc\" INTEGER NOT NULL, \"previous_version\" TEXT NULL, PRIMARY KEY (\"type\"));"
