          "sql": "CREATE TABLE IF NOT EXISTS \"quran_highlight_regions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"highlight_id\" INTEGER NOT NULL REFERENCES quran_highlights (id) ON DELETE CASCADE, \"page\" INTEGER NOT NULL, \"x0\" REAL NOT NULL, \"y0\" REAL NOT NULL, \"x1\" REAL NOT NULL, \"y1\" REAL NOT NULL);"
