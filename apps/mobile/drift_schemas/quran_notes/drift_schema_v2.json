      ]
    },
    {
      "name": "quran_highlights",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"quran_highlights\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"layout_id\" TEXT NOT NULL, \"color\" TEXT NOT NULL, \"first_page\" INTEGER NOT NULL, \"created_utc\" INTEGER NOT NULL, \"updated_utc\" INTEGER NOT NULL);"
        }
      ]
    },
    {
