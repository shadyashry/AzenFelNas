# Normalise text files to LF in the repository; binaries are detected automatically.
* text=auto eol=lf
*.bat text eol=crlf
*.png binary
*.jar binary
*.docx binary
*.pdf binary
# TUF-lite packages and the signed round-trip vector: hashes and signatures pin their exact bytes (§15 D62).
*.dmpkg binary
tools/gsctl/testdata/roundtrip/dev/** -text
