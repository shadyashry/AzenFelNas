{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dailymuslim.app/schemas/hijri_package.v1.schema.json",
  "title": "Hijri package payload v1",
  "description": "Per-country Hijri month starts (DESIGN.md §9.5, ADR-016). Confirmed months carry their official source; expected months have none.",
  "type": "object",
  "additionalProperties": false,
  "required": ["country", "months"],
  "properties": {
    "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "months": { "type": "array", "items": { "$ref": "#/$defs/month" } }
  },
  "$defs": {
    "month": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hijriYear", "hijriMonth", "gregorianStart", "status"],
      "properties": {
        "hijriYear": { "type": "integer", "minimum": 1 },
        "hijriMonth": { "type": "integer", "minimum": 1, "maximum": 12 },
        "gregorianStart": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "status": { "enum": ["confirmed", "expected"] },
        "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" }
      },
      "if": { "properties": { "status": { "const": "confirmed" } } },
      "then": { "required": ["sourceUrl"] }
    }
  }
}
