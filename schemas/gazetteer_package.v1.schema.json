{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azenfelnas.app/schemas/gazetteer_package.v1.schema.json",
  "title": "Gazetteer package payload v1",
  "description": "Offline place search entries from GeoNames cities15000 with Arabic/English alternate names (DESIGN.md §9.5, ADR-015); imported into drift at activation.",
  "type": "array",
  "items": { "$ref": "#/$defs/place" },
  "$defs": {
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "asciiName", "altNames", "country", "admin1", "lat", "lon", "population", "zoneId"],
      "properties": {
        "id": { "type": "integer", "minimum": 1, "description": "GeoNames id." },
        "name": { "type": "string", "minLength": 1 },
        "asciiName": { "type": "string", "minLength": 1 },
        "altNames": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ar", "en"],
          "properties": {
            "ar": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "en": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "admin1": { "type": "string", "description": "GeoNames admin1 code; empty when unknown." },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "population": { "type": "integer", "minimum": 0 },
        "zoneId": { "type": "string", "pattern": "^[A-Za-z_]+(/[A-Za-z0-9_+-]+)*$", "maxLength": 64 }
      }
    }
  }
}
