{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dailymuslim.app/schemas/benchmark_cities.v1.schema.json",
  "title": "Benchmark cities v1",
  "description": "The Accuracy Lab benchmark city file lab/benchmarks/cities.v1.json (DESIGN.md Appendix H, §9.4): the cities and the rule that selects their benchmark dates. Civil and astronomical data only; no religious parameter (§0.2 rule 1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "dateSet", "cities"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": { "type": "string", "minLength": 1, "description": "Where the city list comes from." },
    "dateSet": { "$ref": "#/$defs/dateSet" },
    "cities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/city" } }
  },
  "$defs": {
    "civilDate": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "city": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cityId", "name", "latitudeDeg", "longitudeDeg", "zoneId", "country"],
      "properties": {
        "cityId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 32 },
        "name": { "type": "string", "minLength": 1 },
        "latitudeDeg": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitudeDeg": { "type": "number", "minimum": -180, "maximum": 180 },
        "zoneId": { "type": "string", "pattern": "^[A-Za-z_]+(/[A-Za-z0-9_+-]+)*$", "maxLength": 64, "description": "IANA zone of the city." },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$", "description": "ISO 3166-1 alpha-2." }
      }
    },
    "dateSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seasons", "dayOfMonth", "dstWindowDays", "ramadan"],
      "description": "Appendix H: both solstices, both equinoxes, the 15th of each month, every DST transition ±7 days, Ramadan start/end 1447–1449.",
      "properties": {
        "seasons": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["MARCH_EQUINOX", "JUNE_SOLSTICE", "SEPTEMBER_EQUINOX", "DECEMBER_SOLSTICE"] },
          "description": "Season instants; each selects the civil date of the instant in the city's zone."
        },
        "dayOfMonth": { "type": "integer", "minimum": 1, "maximum": 28 },
        "dstWindowDays": { "type": "integer", "minimum": 0, "maximum": 31, "description": "Each UTC-offset transition day of the city's zone selects the days from −n to +n around it." },
        "ramadan": { "type": "array", "items": { "$ref": "#/$defs/ramadanMonth" } }
      }
    },
    "ramadanMonth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hijriYear", "firstDay", "lastDay", "confidence", "source"],
      "properties": {
        "hijriYear": { "type": "integer", "minimum": 1 },
        "firstDay": { "$ref": "#/$defs/civilDate" },
        "lastDay": { "$ref": "#/$defs/civilDate" },
        "confidence": { "enum": ["CONFIRMED", "EXPECTED"] },
        "source": { "type": "string", "minLength": 1 }
      }
    }
  }
}
