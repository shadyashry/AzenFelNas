{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dailymuslim.app/schemas/prayer_profile.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profileId",
    "schemaVersion",
    "version",
    "status",
    "effectiveFrom",
    "scope",
    "authority",
    "referenceMode",
    "referencePoints",
    "rules",
    "horizon",
    "highLatitude",
    "rounding",
    "adjustments",
    "evidence",
    "approvals",
    "compatibility"
  ],
  "properties": {
    "profileId": {
      "type": "string",
      "pattern": "^[a-z]{2}\\.[a-z0-9_]+\\.[a-z0-9_]+$|^engine\\.default$"
    },
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{1,2}\\.\\d+$"
    },
    "status": {
      "enum": [
        "DRAFT_UNVERIFIED",
        "CANDIDATE",
        "APPROVED",
        "RETIRED"
      ]
    },
    "effectiveFrom": {
      "type": "string",
      "format": "date"
    },
    "effectiveTo": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "countries"
      ],
      "properties": {
        "countries": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$|^\\*$"
          }
        },
        "adminAreas": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$"
          }
        },
        "polygonsRef": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "authority": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "enum": [
            "GOVERNMENT",
            "RECOGNIZED_BODY",
            "COMMUNITY_CONVENTION",
            "ENGINE_DEFAULT"
          ]
        }
      }
    },
    "referenceMode": {
      "enum": [
        "EXACT_COORDINATE",
        "AUTHORITY_REFERENCE_POINT"
      ]
    },
    "referencePoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "area",
          "lat",
          "lon"
        ],
        "properties": {
          "area": {
            "type": "string"
          },
          "lat": {
            "type": "number"
          },
          "lon": {
            "type": "number"
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fajr",
        "sunrise",
        "dhuhr",
        "asr",
        "maghrib",
        "isha"
      ],
      "properties": {
        "imsak": {
          "oneOf": [
            {
              "$ref": "#/$defs/rule"
            },
            {
              "type": "null"
            }
          ]
        },
        "fajr": {
          "$ref": "#/$defs/rule"
        },
        "sunrise": {
          "$ref": "#/$defs/rule"
        },
        "dhuhr": {
          "$ref": "#/$defs/rule"
        },
        "asr": {
          "$ref": "#/$defs/rule"
        },
        "maghrib": {
          "$ref": "#/$defs/rule"
        },
        "isha": {
          "$ref": "#/$defs/rule"
        }
      }
    },
    "horizon": {
      "type": "object",
      "required": [
        "elevationPolicy"
      ],
      "properties": {
        "elevationPolicy": {
          "enum": [
            "NONE",
            "ABOVE_LOCAL_TERRAIN",
            "AUTHORITY_TABLE"
          ]
        }
      }
    },
    "highLatitude": {
      "type": "object",
      "required": [
        "chain"
      ],
      "properties": {
        "chain": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/hlMethod"
          }
        }
      }
    },
    "rounding": {
      "type": "object",
      "required": [
        "default"
      ],
      "properties": {
        "default": {
          "$ref": "#/$defs/rounding"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/rounding"
      }
    },
    "adjustments": {
      "type": "object",
      "required": [
        "maxAbsMinutes"
      ],
      "properties": {
        "perEventMinutes": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": -10,
            "maximum": 10
          }
        },
        "maxAbsMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "ramadan": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/rule"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "sources",
        "benchmarkSet"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "url",
              "retrievedOn",
              "sha256"
            ]
          }
        },
        "benchmarkSet": {
          "type": "string"
        },
        "holdoutReport": {
          "type": [
            "string",
            "null"
          ]
        },
        "benchmarkReportId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "approvals": {
      "type": "object",
      "properties": {
        "religious": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "reviewer",
            "qualification",
            "date",
            "scope"
          ]
        },
        "accuracy": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "reviewer",
            "date"
          ]
        }
      }
    },
    "compatibility": {
      "type": "object",
      "required": [
        "minEngineSchema",
        "minAppVersion"
      ]
    }
  },
  "$defs": {
    "rounding": {
      "enum": [
        "ceil",
        "floor",
        "nearest"
      ]
    },
    "rule": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "degrees"
          ],
          "properties": {
            "type": {
              "const": "solarAltitude"
            },
            "degrees": {
              "type": "number",
              "minimum": 5,
              "maximum": 25
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "transit"
            },
            "offsetMinutes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "k"
          ],
          "properties": {
            "type": {
              "const": "shadowFactor"
            },
            "k": {
              "enum": [
                1,
                2
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "horizon"
            },
            "refractionArcmin": {
              "type": "number",
              "minimum": 0,
              "maximum": 60
            },
            "semidiameterArcmin": {
              "type": "number",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "base",
            "minutes"
          ],
          "properties": {
            "type": {
              "const": "intervalAfter"
            },
            "base": {
              "enum": [
                "maghrib"
              ]
            },
            "minutes": {
              "type": "integer",
              "minimum": 30,
              "maximum": 150
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "base",
            "minutes"
          ],
          "properties": {
            "type": {
              "const": "intervalBefore"
            },
            "base": {
              "enum": [
                "fajr"
              ]
            },
            "minutes": {
              "type": "integer",
              "minimum": 5,
              "maximum": 120
            }
          }
        }
      ]
    },
    "hlMethod": {
      "oneOf": [
        {
          "const": "anglePortion"
        },
        {
          "const": "middleOfNight"
        },
        {
          "const": "seventhOfNight"
        },
        {
          "type": "object",
          "required": [
            "nearestLatitude"
          ],
          "properties": {
            "nearestLatitude": {
              "type": "object",
              "required": [
                "latDeg"
              ],
              "properties": {
                "latDeg": {
                  "type": "number",
                  "minimum": 40,
                  "maximum": 60
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "nearestValidDay"
          ],
          "properties": {
            "nearestValidDay": {
              "type": "object",
              "required": [
                "maxDays"
              ],
              "properties": {
                "maxDays": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 60
                }
              }
            }
          }
        }
      ]
    }
  }
}
