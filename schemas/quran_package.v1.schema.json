{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azenfelnas.app/schemas/quran_package.v1.schema.json",
  "title": "Quran package manifest v1",
  "description": "manifest.json of the offline Quran package (DESIGN.md §9.5, §15 D107): the edition, its sources and licences, the page image geometry and every file with its size and sha256. The app pins this manifest's own sha256, so every file it lists is verified against a value the app was built with.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageId", "version", "layoutId", "edition", "pageImage", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "e.g. hafs-madinah-1441." },
    "version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$", "description": "Package build, e.g. 1441.1." },
    "layoutId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Identity of the page layout. Bookmarks and highlights are stored against it; a package with another layoutId never shows them."
    },
    "edition": { "$ref": "#/$defs/edition" },
    "pageImage": { "$ref": "#/$defs/pageImage" },
    "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } }
  },
  "$defs": {
    "hex64": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "edition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["riwayah", "publisher", "printEdition", "pageCount", "suraCount", "verseCount", "sources"],
      "properties": {
        "riwayah": { "enum": ["hafs"] },
        "publisher": { "type": "string", "minLength": 1 },
        "printEdition": { "type": "string", "minLength": 1, "description": "e.g. 1441 (Hijri year of the digital edition)." },
        "pageCount": { "type": "integer", "minimum": 1 },
        "suraCount": { "type": "integer", "minimum": 1 },
        "verseCount": { "type": "integer", "minimum": 1 },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "url", "sha256", "version", "license"],
      "properties": {
        "role": { "enum": ["pages", "text", "juz"] },
        "url": { "type": "string", "pattern": "^https://" },
        "sha256": { "$ref": "#/$defs/hex64" },
        "version": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "pageImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "width", "height", "pathPattern"],
      "properties": {
        "format": { "enum": ["webp-lossless"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "pathPattern": { "type": "string", "pattern": "^[a-z]+/\\{page:03\\}\\.webp$", "description": "e.g. pages/{page:03}.webp." }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*(/[a-z0-9_-][a-z0-9_.-]*)*$",
          "description": "Relative to the package directory; lowercase, no '..' segment."
        },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/hex64" }
      }
    }
  }
}
