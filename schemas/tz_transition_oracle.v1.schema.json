{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azenfelnas.app/schemas/tz_transition_oracle.v1.schema.json",
  "title": "TZ transition oracle v1",
  "description": "Independent reference for the DST transition suite (DESIGN.md §13 S10, §15 D66-D67): for each benchmark-corpus zone, the UTC offset changes in [fromYear-01-01, toYear+1-01-01) and, for every civil day within windowDays of a transition's local date, the conversions CPython zoneinfo computes from the same zic output the tzdata package is encoded from. Written by `dm-pipelines tzdata build`; read by dm_civil_time's tests. Instants are UTC epoch milliseconds; offsets are seconds, local = UTC + offset.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tzdbVersion", "fromYear", "toYear", "windowDays", "zones"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "tzdbVersion": { "type": "string", "pattern": "^\\d{4}[a-z]+$", "description": "IANA release, e.g. 2026e." },
    "fromYear": { "type": "integer", "minimum": 1 },
    "toYear": { "type": "integer", "minimum": 1 },
    "windowDays": { "type": "integer", "minimum": 0, "maximum": 31 },
    "zones": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/zone" } }
  },
  "$defs": {
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zoneId", "offsetAtStartSeconds", "transitions", "days"],
      "properties": {
        "zoneId": { "type": "string", "pattern": "^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*$" },
        "offsetAtStartSeconds": { "type": "integer", "minimum": -93600, "maximum": 93600, "description": "Offset at fromYear-01-01T00:00Z." },
        "transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" } },
        "days": { "type": "array", "items": { "$ref": "#/$defs/day" }, "description": "Empty when the zone has no transition in the range." }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["utcMs", "offsetBeforeSeconds", "offsetAfterSeconds"],
      "properties": {
        "utcMs": { "type": "integer", "description": "First instant of the new offset." },
        "offsetBeforeSeconds": { "type": "integer", "minimum": -93600, "maximum": 93600 },
        "offsetAfterSeconds": { "type": "integer", "minimum": -93600, "maximum": 93600 }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["day", "startOfDayUtcMs", "localHourUtcMs", "hourOffsetsSeconds"],
      "properties": {
        "day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "startOfDayUtcMs": { "type": "integer", "description": "First instant whose local date is `day`." },
        "localHourUtcMs": {
          "type": "array", "minItems": 24, "maxItems": 24, "items": { "type": "integer" },
          "description": "UTC instant of local `day` h:00 for h = 0..23, resolved as PEP 495 fold = 0 (overlap: earlier instant; gap: moved forward by the gap)."
        },
        "hourOffsetsSeconds": {
          "type": "array", "minItems": 24, "maxItems": 24, "items": { "type": "integer" },
          "description": "Offset in effect at localHourUtcMs[h], seconds."
        }
      }
    }
  }
}
